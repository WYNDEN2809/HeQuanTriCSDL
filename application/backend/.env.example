# Sao chep file nay thanh .env roi sua gia tri cho may cua ban. KHONG commit file .env len GitHub.

DJANGO_SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- SQL Server ----
DB_NAME=ScentStationDB
# May thuong:        localhost
# SQL Express:       localhost\SQLEXPRESS   (de DB_PORT trong)
# Docker/port rieng: localhost  + DB_PORT=1433
DB_HOST=localhost
DB_PORT=

# Cach 1: dang nhap SQL Server (SQL Authentication)
DB_USER=sa
DB_PASSWORD=MatKhauCuaBan

# Cach 2: dang nhap bang tai khoan Windows (Windows Authentication)
# -> dat DB_TRUSTED=True va de trong DB_USER / DB_PASSWORD
DB_TRUSTED=False

DB_DRIVER=ODBC Driver 18 for SQL Server

# ---- Buoc 2: ban hang & thiet bi (co gia tri mac dinh, chi can sua khi muon doi) ----
PAYMENT_WEBHOOK_SECRET=doi-chuoi-bi-mat-webhook
DEVICE_API_SECRET=doi-chuoi-bi-mat-thiet-bi
PAYMENT_SANDBOX_ENABLED=True
ORDER_TTL_SECONDS=300
DISPENSE_COMMAND_TTL_SECONDS=120
HEARTBEAT_ONLINE_SECONDS=30
HEARTBEAT_OFFLINE_SECONDS=90
KIOSK_IDLE_SECONDS=60
